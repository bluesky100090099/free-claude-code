# ---------- AI (free) ----------
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash   # falls back to other Flash models automatically
REELS_LANGUAGE=ar          # caption / copy language (ar, en, fr, ...)
WHISPER_MODEL=small        # tiny | base | small | medium | large-v3
WHISPER_DEVICE=auto        # auto | cuda | cpu

# ---------- YouTube Shorts ----------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=          # python -m reels auth youtube
YT_PRIVACY=public          # public | unlisted | private

# ---------- Instagram Reels (Business/Creator account) ----------
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---------- Facebook Page Reels ----------
FB_PAGE_ID=
FB_PAGE_TOKEN=

META_GRAPH_VERSION=v23.0

# ---------- TikTok (Content Posting API) ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_MODE=inbox          # inbox = sent to your TikTok drafts | direct = posted
TIKTOK_PRIVACY=SELF_ONLY   # unaudited apps can only post SELF_ONLY
